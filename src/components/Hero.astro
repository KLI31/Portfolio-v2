---
import type es from "../i18n/es.json";
import { RotatingText } from "./RotatingText";
import { SpotifyWidget } from "./SpotifyWidget";
import Github from "../icons/Github.astro";
import LinkedIn from "../icons/LinkedIn.astro";
import Mail from "../icons/Mail.astro";
import "../style.css";

interface Props {
  hero: typeof es.hero;
  locale: "es" | "en";
}

const { hero, locale } = Astro.props;
---

<div class="max-w-3xl mx-auto">

  <div class="flex items-center gap-3 mb-6">
    <picture class="shrink-0">
      <source
        srcset="/icon.webp 300w, /icon.webp 800w"
        sizes="(max-width: 768px) 64px, 64px"
        type="image/webp"
      />
      <img
        src="/icon.webp"
        alt={hero.profileImageAlt}
        class="w-16 h-16 rounded-xl object-cover ring-1 ring-gray-200 dark:ring-gray-700"
        loading="lazy"
      />
    </picture>
    <div class="min-w-0">
      <h1 class="text-[1.75rem] font-bold text-gray-900 dark:text-white leading-tight tracking-tight">
        {hero.fullName}
      </h1>
      <p class="text-sm text-gray-500 dark:text-gray-400 mt-0.5">
        <RotatingText phrases={hero.rotatingPhrases} client:load />
      </p>
    </div>
  </div>


  <p
    class="text-[15px] leading-loose text-gray-600 dark:text-gray-400 mb-6 [&>strong]:font-semibold [&>strong]:text-yellow-600 dark:[&>strong]:text-white"
    set:html={hero.intro}
  />


  <div class="mb-5">
    <SpotifyWidget locale={locale} client:idle />
  </div>


  <div class="flex items-center gap-5">
    <a
      href="https://github.com/KLI31"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={hero.githubAria}
      class="text-gray-500 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white transition-colors duration-200"
    >
      <Github width="20px" />
    </a>
    <a
      href="https://www.linkedin.com/in/luisrambao/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label={hero.linkedinAria}
      class="text-gray-500 dark:text-gray-400 hover:text-blue-500 dark:hover:text-blue-400 transition-colors duration-200"
    >
      <LinkedIn width="20px" />
    </a>
    <a
      href={`mailto:${hero.email}`}
      aria-label={hero.emailAria}
      class="text-gray-500 dark:text-gray-400 hover:text-yellow-500 dark:hover:text-white transition-colors duration-200"
    >
      <Mail class="w-5 h-5" />
    </a>
  </div>
</div>
