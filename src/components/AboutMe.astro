---
import type es from "../i18n/es.json";

interface Props {
  about: typeof es.about;
}

const { about } = Astro.props;
---

<div class="space-y-4 text-sm text-gray-600 dark:text-gray-400 leading-relaxed max-w-none">
  <p set:html={about.p1} class="[&>strong]:font-semibold [&>strong]:text-yellow-600 dark:[&>strong]:text-white" />

  <p set:html={about.p2} class="[&>strong]:font-semibold [&>strong]:text-yellow-600 dark:[&>strong]:text-white" />

  <p set:html={about.p3} class="[&>strong]:font-semibold [&>strong]:text-yellow-600 dark:[&>strong]:text-white" />

  <p set:html={about.p4} class="[&>strong]:font-semibold [&>strong]:text-yellow-600 dark:[&>strong]:text-white" />
</div>
