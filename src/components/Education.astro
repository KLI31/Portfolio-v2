---
import EducationItem from "../components/EducationItem.astro";

interface Item {
  college: string;
  image: string;
  degree: string;
  date: string;
  description: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="relative space-y-6">
  {
    items.map((education, index) => (
      <li class={index < items.length - 1 ? "pb-6 border-b border-gray-200/60 dark:border-gray-800/40" : ""}>
        <EducationItem {...education} />
      </li>
    ))
  }
</ol>
