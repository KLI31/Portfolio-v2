---
import EducationItem from "../components/EducationItem.astro";

interface Item {
  college: string;
  image: string;
  degree: string;
  date: string;
  description: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<ol class="relative">
  {
    items.map((education) => (
      <li class="">
        <EducationItem {...education} />
      </li>
    ))
  }
</ol>
