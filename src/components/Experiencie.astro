---
import ExperienceItem from "../components/ExperienceItem.astro";

interface Item {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
}

interface Props {
  items: Item[];
  recommendationLetter: string;
}

const { items, recommendationLetter } = Astro.props;
---

<ol class="relative">
  {
    items.map((experiencie) => (
      <li class="">
        <ExperienceItem
          {...experiencie}
          recommendationLetter={recommendationLetter}
        />
      </li>
    ))
  }
</ol>
