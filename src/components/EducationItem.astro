---

interface Props {
    college: string,
    image: string,
    degree: string,
    date: string,
    description: string,
}

const {college, image, degree, date, description } = Astro.props

---

<div class="flex gap-3">
  <img
    src={image}
    alt={college}
    class="w-10 h-10 rounded-lg object-cover ring-1 ring-gray-200 dark:ring-gray-700 shrink-0"
  />
  <div class="flex-1 min-w-0">
    <div class="flex items-start justify-between gap-4 flex-wrap mb-0.5">
      <h3 class="font-semibold text-yellow-500 dark:text-white text-sm leading-snug">
        {college}
      </h3>
      <time class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap flex-shrink-0 pt-px">
        {date}
      </time>
    </div>

    <p class="text-sm text-gray-500 dark:text-gray-400">
      {degree}
    </p>
  </div>
</div>
