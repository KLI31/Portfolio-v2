---
interface Tag {
  name: string;
  class: string;
  icon: any;
}

interface Props {
  title: string;
  company: string;
  description: string;
  link?: string;
  date: string;
  location?: string;
  bullets?: string[];
  tags?: Tag[];
  recommendationLetter: string;
}

const {
  title,
  company,
  description,
  link,
  date,
  location,
  bullets,
  tags,
  recommendationLetter,
} = Astro.props;
---

<div>
  <!-- Title · Company | Date -->
  <div class="flex items-start justify-between gap-4 flex-wrap mb-0.5">
    <h3 class="font-semibold text-yellow-600 dark:text-white text-sm leading-snug">
      {title}
      {
        company && (
          <span class="font-normal text-gray-500 dark:text-gray-400 ml-1">
            · {company}
          </span>
        )
      }
    </h3>
    <time class="text-xs text-gray-500 dark:text-gray-400 whitespace-nowrap flex-shrink-0 pt-px">
      {date}
    </time>
  </div>

  <!-- Location + recommendation letter on same row -->
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2 mb-3 mt-1">
    {
      location && (
        <p class="text-xs text-gray-500 dark:text-gray-500">{location}</p>
      )
    }
    {
      link && (
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 text-[11px] font-medium px-2.5 py-1 rounded-full border border-gray-300 dark:border-gray-600 text-gray-600 dark:text-gray-300 hover:border-yellow-400 hover:text-yellow-600 dark:hover:border-yellow-500 dark:hover:text-yellow-400 transition-all duration-200"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-3 h-3 shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
            <polyline points="14 2 14 8 20 8" />
            <line x1="16" y1="13" x2="8" y2="13" />
            <line x1="16" y1="17" x2="8" y2="17" />
            <line x1="10" y1="9" x2="8" y2="9" />
          </svg>
          {recommendationLetter}
        </a>
      )
    }
  </div>


  <p class="text-sm text-gray-600 dark:text-gray-400 leading-relaxed mb-2">
    {description}
  </p>


  {
    bullets && bullets.length > 0 && (
      <ul class="mb-3 space-y-1.5">
        {bullets.map((bullet) => (
          <li class="flex gap-2 text-sm text-gray-600 dark:text-gray-400 leading-relaxed">
            <span class="flex-shrink-0 opacity-40 select-none">·</span>
            <span>{bullet}</span>
          </li>
        ))}
      </ul>
    )
  }


  {
    tags && tags.length > 0 && (
      <div class="flex flex-wrap gap-3 mt-3">
        {tags.map((tag) => {
          const Icon = tag.icon;
          return (
            <span class="relative group cursor-pointer inline-block">
              <span class="[&_svg]:w-5.5 [&_svg]:h-5.5 [&_svg]:block opacity-80 group-hover:opacity-100 transition-all duration-300 ease-out hover:scale-105 inline-block">
                <Icon />
              </span>
              <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-0.5 rounded-md text-[11px] font-medium bg-gray-900 dark:bg-zinc-100 text-white dark:text-gray-900 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 z-20 shadow-sm">
                {tag.name}
              </span>
            </span>
          );
        })}
      </div>
    )
  }
</div>
