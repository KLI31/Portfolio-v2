---
import Github from "../icons/Github.astro";
import Globe from "../icons/Globe.astro";

interface Project {
  name: string;
  emoji: string;
  summary: string;
  link?: string;
  github?: string;
  image: string;
  tags: { name: string; class: string; icon: any }[];
}

interface Props {
  projects: Project[];
  codeLabel: string;
  goToLinkLabel: string;
}

const { projects, codeLabel, goToLinkLabel } = Astro.props;
---

<ul class="grid grid-cols-1 gap-3 md:grid-cols-2" role="list">
  {
    projects.map(({ name, summary, link, github, image, tags }) => {
      return (
        <li>
          <article class="flex h-full flex-col rounded-xl overflow-hidden ring-1 ring-black/[0.07] dark:ring-white/[0.08]">

            {/* Screenshot */}
            <div class="aspect-video overflow-hidden border-b border-zinc-200 dark:border-zinc-700/60">
              <img
                src={image}
                alt={name}
                width="640"
                height="360"
                class="w-full h-full object-cover object-top"
                loading="lazy"
              />
            </div>

            {/* Card body */}
            <div class="flex flex-col flex-1 p-4 bg-white dark:bg-neutral-950/70">

              <div class="flex items-center justify-between gap-2 mb-1.5">
                <h3 class="font-semibold text-base text-gray-900 dark:text-white leading-snug">
                  {name}
                </h3>
                <div class="flex items-center shrink-0">
                  {github && (
                    <a
                      href={github}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${name} — ${codeLabel}`}
                      class="p-1.5 rounded-md text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-white transition-colors"
                    >
                      <Github width="18px" height="18px" />
                    </a>
                  )}
                  {link && (
                    <a
                      href={link}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={`${name} — ${goToLinkLabel}`}
                      class="p-1.5 rounded-md text-gray-400 dark:text-gray-500 hover:text-gray-700 dark:hover:text-white transition-colors"
                    >
                      <Globe class="size-[18px]" />
                    </a>
                  )}
                </div>
              </div>

              <p class="text-[13px] leading-relaxed text-gray-500 dark:text-gray-400 flex-1 mb-3">
                {summary}
              </p>

              <div class="flex flex-wrap gap-2">
                {tags.map((tag) => {
                  const Icon = tag.icon;
                  return (
                    <span
                      class="relative group inline-block [&_svg]:w-6 [&_svg]:h-6 [&_svg]:block cursor-pointer opacity-60 hover:opacity-100 transition-all duration-200 ease-out hover:scale-110"
                    >
                      <Icon />
                      <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-0.5 rounded-md text-[11px] font-medium bg-gray-900 dark:bg-zinc-100 text-white dark:text-gray-900 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 z-20 shadow-sm">
                        {tag.name}
                      </span>
                    </span>
                  );
                })}
              </div>

            </div>
          </article>
        </li>
      );
    })
  }
</ul>
