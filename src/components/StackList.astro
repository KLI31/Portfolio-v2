---
import { STACK } from "../const";

const CATEGORIES = [
  { key: "frontend", label: "Frontend" },
  { key: "backend", label: "Backend" },
  { key: "cloud", label: "Cloud & DevOps" },
  { key: "ia", label: "IA" },
];

const grouped = CATEGORIES.map(cat => ({
  ...cat,
  items: STACK.filter(s => s.category === cat.key),
}));
---

<section class="space-y-6">
  {grouped.map((category) => (
    <div>
      <p class="text-[10px] font-semibold uppercase tracking-widest text-gray-400 dark:text-gray-500 mb-3">
        {category.label}
      </p>
      <ul class="flex flex-wrap gap-2.5">
        {category.items.map(stack => (
          <li
            class="relative group w-11 h-11 rounded-xl flex items-center justify-center transition-transform duration-200 hover:scale-105"
            style={`background-color: ${stack.color}15; border: 1px solid ${stack.color}25;`}
          >
            <stack.icon class="w-5 h-5 block object-contain" style={`color: ${stack.color};`} />
            <span class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-2 py-0.5 rounded-md text-[11px] font-medium bg-gray-900 dark:bg-zinc-100 text-white dark:text-gray-900 whitespace-nowrap opacity-0 group-hover:opacity-100 transition-opacity duration-150 z-20 shadow-sm">
              {stack.name}
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</section>